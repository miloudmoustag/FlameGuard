    {"id": "F4", "experiment": "SAFFIRE vs BASS", "finding": "Steady spread rates in large SAFFIRE samples were significantly lower than BASS at the same O2 and flow rate.", "source": "https://par.nsf.gov/servlets/purl/10313745"},
    {"id": "F5", "experiment": "BASS / CFD", "finding": "Flame spread rate in a duct first rises then falls with decreasing duct height; below a limiting height the flame fails to spread (confinement and O2 depletion).", "source": "https://par.nsf.gov/servlets/purl/10313745"},
    {"id": "F6", "experiment": "ISS thin solid", "finding": "At 18.7% O2 and 1 atm, reducing flow from 5 to 2.2 cm/s caused quenching extinction. Low flow is a shutdown mechanism.", "source": "https://ntrs.nasa.gov/api/citations/20150000894/downloads/20150000894.pdf"},
